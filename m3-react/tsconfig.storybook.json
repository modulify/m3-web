{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "shims-*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "types/**/*.d.ts",
    "storybook/**/*.ts",
    "storybook/**/*.tsx"
  ],
  "exclude": [
    "tests"
  ]
}
