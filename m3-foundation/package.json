{
  "name": "@modulify/m3-foundation",
  "type": "module",
  "description": "Styles for Material Design v3",
  "license": "ISC",
  "version": "0.0.0",
  "keywords": [
    "CSS",
    "material",
    "material design",
    "scaffolding",
    "styles"
  ],
  "files": [
    "assets",
    "dist",
    "types"
  ],
  "exports": {
    "./lib/calendar": {
      "types": "./dist/lib/calendar/index.d.ts",
      "import": "./dist/lib/calendar.mjs",
      "require": "./dist/lib/calendar.cjs"
    },
    "./lib/motion": {
      "types": "./dist/lib/motion/index.d.ts",
      "import": "./dist/lib/motion.mjs",
      "require": "./dist/lib/motion.cjs"
    },
    "./lib/popper": {
      "types": "./dist/lib/popper/index.d.ts",
      "import": "./dist/lib/popper.mjs",
      "require": "./dist/lib/popper.cjs"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.mjs",
      "require": "./dist/lib/*.cjs"
    },
    "./types/*": {
      "types": "./types/*.d.ts"
    },
    "./assets/*": "./assets/*",
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && sass assets/stylesheets/m3-foundation.scss dist/index.css --no-source-map",
    "eslint": "eslint ./lib ./types ./tests ./vite.config.ts ./vitest.config.ts",
    "tsc": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.5",
    "@modulify/validator": "^0.1.0",
    "lodash.isequal": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@omnicajs/eslint-plugin-dependencies": "^0.0.4",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^24.19.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "sass": "^1.105.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "uuid": "^14.0.2",
    "vite": "^8.3.1"
  },
  "contributors": [
    "Zaitsev Kirill <zaytsev.cmath10@gmail.com>"
  ],
  "homepage": "https://github.com/modulify/m3-web/m3-foundation/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/modulify/m3-web.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ]
}
