{
  "name": "@modulify/m3-react",
  "type": "module",
  "description": "Material design v3 components for React",
  "license": "ISC",
  "version": "0.0.0",
  "keywords": [
    "components",
    "material",
    "material design",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./dist/m3-react.cjs",
      "import": "./dist/m3-react.mjs",
      "default": "./dist/m3-react.mjs"
    },
    "./dist/*": "./dist/*",
    "./types/*": "./types/*"
  },
  "scripts": {
    "build": "vite build",
    "eslint": "eslint ./src ./storybook ./tests ./types",
    "storybook": "storybook dev -c storybook -p 6006 --no-open",
    "storybook:build": "storybook build -c storybook -o dist-storybook",
    "test:smoke": "VITEST_STORYBOOK=false vitest run --config vitest.config.smoke.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:coverage": "vitest run --config vitest.config.e2e.ts --coverage --coverage.provider=istanbul --coverage.reporter=json",
    "test": "vitest run",
    "tsc": "tsc --noEmit -p tsconfig.tsc.json",
    "tsc:tests": "tsc --noEmit -p tsconfig.tests.json --skipLibCheck"
  },
  "dependencies": {
    "@floating-ui/core": "^1.7.4",
    "@floating-ui/dom": "^1.7.5",
    "@modulify/m3-foundation": "0.0.0",
    "lodash.isequal": "^4.5.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-transition-group": "^4.4.5",
    "react-transition-state": "^2.1.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/builder-vite": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^25.3.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-transition-group": "^4.4.12",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.4.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "flag-icons": "^7.5.0",
    "globals": "^17.3.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-transition-group": "^4.4.5",
    "react-transition-state": "^2.3.3",
    "sass": "^1.97.3",
    "storybook": "^10.4.6",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "uuid": "^14.0.1",
    "vite": "^8.1.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.9"
  },
  "contributors": [
    "Zaitsev Kirill <zaytsev.cmath10@gmail.com>"
  ],
  "homepage": "https://github.com/modulify/m3-web/m3-react/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/modulify/m3-web.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
