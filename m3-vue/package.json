{
  "name": "@modulify/m3-vue",
  "type": "module",
  "description": "Material design v3 components for vue",
  "license": "ISC",
  "version": "0.0.0",
  "keywords": [
    "components",
    "material",
    "material design",
    "vue"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./dist/m3-vue.cjs",
      "import": "./dist/m3-vue.mjs",
      "default": "./dist/m3-vue.mjs"
    },
    "./dist/*": "./dist/*",
    "./types/*": "./types/*"
  },
  "scripts": {
    "build": "vite build",
    "eslint": "eslint ./src ./storybook ./tests ./types",
    "storybook": "storybook dev -c storybook -p 6006 --no-open",
    "storybook:build": "storybook build -c storybook -o dist-storybook",
    "test": "vitest run",
    "tsc": "vue-tsc --noEmit -p tsconfig.tsc.json"
  },
  "dependencies": {
    "@floating-ui/core": "^1.6.0",
    "@floating-ui/dom": "^1.6.3",
    "@modulify/m3-foundation": "0.0.0",
    "lodash.isequal": "^4.5.0"
  },
  "peerDependencies": {
    "vue": "^3.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/js": "9.39.3",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/addon-links": "^10.2.10",
    "@storybook/addon-themes": "^10.2.10",
    "@storybook/builder-vite": "^10.2.10",
    "@storybook/vue3": "^10.2.10",
    "@storybook/vue3-vite": "^10.2.10",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/user-event": "^14.5.2",
    "@testing-library/vue": "^8.1.0",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/language-server": "^2.2.0",
    "eslint": "9.39.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "10.8.0",
    "flag-icons": "^7.2.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.71.1",
    "storybook": "^10.2.10",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.56.0",
    "uuid": "^9.0.1",
    "vite": "^7.3.1",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^4.0.18",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.4.0",
    "vue-router": "^4.3.0",
    "vue-tsc": "^2.2.0"
  },
  "contributors": [
    "Zaitsev Kirill <zaytsev.cmath10@gmail.com>"
  ],
  "homepage": "https://github.com/modulify/m3-web/m3-vue/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/modulify/m3-web.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
