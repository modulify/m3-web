{
  "name": "@modulify/m3-react",
  "type": "module",
  "description": "Material design v3 components for React",
  "license": "ISC",
  "version": "0.0.0",
  "keywords": [
    "components",
    "material",
    "material design",
    "react"
  ],
  "files": [
    "dist"
  ],
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./components": {
      "types": "./dist/types/components/index.d.ts",
      "require": "./dist/components.cjs",
      "import": "./dist/components.mjs",
      "default": "./dist/components.mjs"
    },
    "./hooks": {
      "types": "./dist/types/hooks/index.d.ts",
      "require": "./dist/hooks.cjs",
      "import": "./dist/hooks.mjs",
      "default": "./dist/hooks.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build --mode package-root && vite build --mode package-components && vite build --mode package-hooks",
    "eslint": "eslint ./src ./storybook ./tests ./vite.config.ts ./vite.config.common.ts",
    "storybook": "storybook dev -c storybook -p 6006 --no-open",
    "storybook:build": "storybook build -c storybook -o dist-storybook",
    "test:smoke": "VITEST_STORYBOOK=false vitest run --config vitest.config.smoke.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:coverage": "vitest run --config vitest.config.e2e.ts --coverage --coverage.provider=istanbul --coverage.reporter=json",
    "test": "vitest run",
    "tsc": "tsc --noEmit -p tsconfig.tsc.json",
    "tsc:storybook": "tsc --noEmit -p tsconfig.storybook.json --skipLibCheck",
    "tsc:tests": "tsc --noEmit -p tsconfig.tests.json --skipLibCheck"
  },
  "dependencies": {
    "@floating-ui/core": "^1.8.0",
    "@floating-ui/dom": "^1.8.0",
    "@modulify/m3-foundation": "0.0.0",
    "@modulify/validator": "^0.3.0",
    "lodash.isequal": "^4.5.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-transition-group": "^4.4.5",
    "react-transition-state": "^2.1.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@eslint/js": "^9.39.4",
    "@modulify/conventional-release": "^0.1.3",
    "@omnicajs/eslint-plugin-dependencies": "^0.0.4",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/builder-vite": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "flag-icons": "^7.5.0",
    "globals": "^17.12.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.1",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-transition-group": "^4.4.5",
    "react-transition-state": "^2.4.0",
    "sass": "^1.105.0",
    "storybook": "^10.6.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "uuid": "^14.0.2",
    "vite": "^8.3.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.2"
  },
  "contributors": [
    "Zaitsev Kirill <zaytsev.cmath10@gmail.com>"
  ],
  "homepage": "https://github.com/modulify/m3-web/m3-react/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/modulify/m3-web.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
