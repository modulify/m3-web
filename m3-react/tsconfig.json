{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2017",
      "esnext.disposable"
    ],
    "paths": {
      "@/*": ["./src/*"],
      "~types/*": ["./types/*"]
    },
    "types": [
      "vitest/globals",
      "vite/client"
    ]
  },
  "include": [
    "shims-*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "storybook/**/*.ts",
    "storybook/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
